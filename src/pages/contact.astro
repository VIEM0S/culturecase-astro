---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact — CultureCase · Bamako, Mali"
  description="Contactez CultureCase pour commander une coque iPhone ou poser vos questions. WhatsApp disponible 7j/7 à Bamako."
  currentPage="contact"
>

<div style="background:#120500;padding:2rem 2.5rem;border-bottom:2px solid rgba(232,160,32,.2)">
  <div style="max-width:700px;margin:0 auto">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:.5rem">
      <div style="width:18px;height:1.5px;background:#E8A020;border-radius:2px"></div>
      <span style="font-size:9px;letter-spacing:2.5px;text-transform:uppercase;color:rgba(232,160,32,.7);font-weight:600">Contact</span>
    </div>
    <h1 style="font-family:'Bebas Neue',sans-serif;font-size:42px;letter-spacing:3px;color:#fff;line-height:.9">
      Parlons-<em style="color:#E8A020;font-style:normal">nous</em>
    </h1>
  </div>
</div>

<div style="max-width:700px;margin:0 auto;padding:2.5rem">

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2.5rem">

    <!-- WhatsApp -->
    <a href="https://wa.me/22375992482" target="_blank" rel="noopener"
      style="display:flex;flex-direction:column;gap:1rem;background:#fff;border:1.5px solid #E2CEAA;border-radius:10px;padding:1.5rem;text-decoration:none;transition:box-shadow .2s">
      <div style="width:44px;height:44px;background:rgba(37,211,102,.1);border-radius:50%;display:flex;align-items:center;justify-content:center">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </div>
      <div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1.5px;color:#0F0700;margin-bottom:.25rem">WhatsApp</div>
        <div style="font-size:12px;color:#9A7848;line-height:1.6">Réponse rapide · 7j/7<br>+223 75 99 24 82</div>
      </div>
      <div style="font-size:11px;font-weight:700;color:#25D366;letter-spacing:.5px">Écrire sur WhatsApp →</div>
    </a>

    <!-- Instagram -->
    <a href="https://www.instagram.com/culturecase_official" target="_blank" rel="noopener"
      style="display:flex;flex-direction:column;gap:1rem;background:#fff;border:1.5px solid #E2CEAA;border-radius:10px;padding:1.5rem;text-decoration:none;transition:box-shadow .2s">
      <div style="width:44px;height:44px;background:rgba(193,53,132,.1);border-radius:50%;display:flex;align-items:center;justify-content:center">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#C13584"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
      </div>
      <div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1.5px;color:#0F0700;margin-bottom:.25rem">Instagram</div>
        <div style="font-size:12px;color:#9A7848;line-height:1.6">Suivez nos nouveautés<br>@culturecase_official</div>
      </div>
      <div style="font-size:11px;font-weight:700;color:#C13584;letter-spacing:.5px">Voir le profil →</div>
    </a>

  </div>

  <!-- Localisation -->
  <div style="background:#FBF6ED;border:1.5px solid #E2CEAA;border-radius:10px;padding:1.5rem;margin-bottom:1.5rem">
    <div style="font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1.5px;color:#0F0700;margin-bottom:1rem">Localisation</div>
    <div style="font-size:13px;color:#5A3E28;line-height:2">
      📍 Bamako, Mali<br>
      📦 Livraison dans tout Bamako<br>
      ⏱ Délai : 24-48h après confirmation<br>
      💳 Paiement à la livraison ou Orange Money
    </div>
  </div>

  <!-- Horaires -->
  <div style="background:#FBF6ED;border:1.5px solid #E2CEAA;border-radius:10px;padding:1.5rem">
    <div style="font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1.5px;color:#0F0700;margin-bottom:1rem">Disponibilité WhatsApp</div>
    <div style="font-size:13px;color:#5A3E28;line-height:2">
      Lundi — Vendredi : 8h → 20h<br>
      Samedi : 9h → 18h<br>
      Dimanche : 10h → 16h<br>
      <span style="color:#D94E15;font-weight:600">Réponse généralement en moins d'1h</span>
    </div>
  </div>

</div>
</Base>
