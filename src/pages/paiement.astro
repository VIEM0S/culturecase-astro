---
import Base from '../layouts/Base.astro';
---
<Base title="Modes de Paiement — CultureCase" description="Modes de paiement acceptés chez CultureCase : espèces, Orange Money, Wave." currentPage="">

<div style="background:#120500;padding:2rem 2.5rem;border-bottom:2px solid rgba(232,160,32,.2)">
  <div style="max-width:760px;margin:0 auto">
    <h1 style="font-family:'Bebas Neue',sans-serif;font-size:38px;letter-spacing:3px;color:#fff;line-height:.9">Modes de <em style="color:#E8A020;font-style:normal">Paiement</em></h1>
  </div>
</div>

<div style="max-width:760px;margin:0 auto;padding:2.5rem;display:flex;flex-direction:column;gap:1.5rem">

  {[
    { emoji:'💵', titre:'Espèces (cash)', desc:'Paiement à la livraison. Le montant exact est communiqué lors de la confirmation WhatsApp.' },
    { emoji:'🔶', titre:'Orange Money', desc:'Transfert Orange Money au +223 75 99 24 82. Envoyez une capture de confirmation sur WhatsApp.' },
    { emoji:'💙', titre:'Wave', desc:'Transfert Wave au +223 75 99 24 82. Envoyez une capture de confirmation sur WhatsApp.' },
    { emoji:'📲', titre:'Moov Money', desc:'Transfert Moov Money disponible. Contactez-nous sur WhatsApp pour les détails.' },
  ].map(p => (
    <div style="background:#fff;border:1.5px solid #E2CEAA;border-radius:10px;padding:1.25rem 1.5rem;display:flex;align-items:flex-start;gap:1rem">
      <div style="font-size:28px;flex-shrink:0">{p.emoji}</div>
      <div>
        <div style="font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:1.5px;color:#0F0700;margin-bottom:.4rem">{p.titre}</div>
        <p style="font-size:13px;color:#5A3E28;line-height:1.8">{p.desc}</p>
      </div>
    </div>
  ))}

  <div style="background:#FBF6ED;border:1.5px solid #E2CEAA;border-radius:10px;padding:1.25rem 1.5rem">
    <p style="font-size:12.5px;color:#9A7848;line-height:1.8">
      <strong style="color:#0F0700">Note :</strong> Aucun paiement n'est demandé avant la livraison pour les commandes cash. Pour les paiements mobile money, la commande est confirmée dès réception de votre capture d'écran.
    </p>
  </div>

</div>
</Base>
