---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const questions = [
  { q:'Comment passer commande ?', r:'Choisissez votre design dans le catalogue, sélectionnez votre modèle iPhone et cliquez sur "Commander sur WhatsApp". Un message pré-rempli s\'ouvre avec votre sélection. Confirmez simplement votre adresse de livraison.' },
  { q:'Quels modèles iPhone sont compatibles ?', r:'Nous couvrons les modèles iPhone 12, 12 Pro Max, 13, 13 Pro, 13 Pro Max (3 500 FCFA) et iPhone 14, 14 Plus, 14 Pro, 14 Pro Max, 15, 15 Plus, 15 Pro, 15 Pro Max, 16, 16 Plus, 16 Pro, 16 Pro Max, 17, 17 Air, 17 Pro, 17 Pro Max (5 000 FCFA).' },
  { q:'Est-ce que les coques protègent bien le téléphone ?', r:'Oui. Nos coques sont en polycarbonate résistant avec des bords surélevés pour protéger l\'écran et le dos du téléphone en cas de chute.' },
  { q:'Les couleurs sont-elles fidèles aux photos ?', r:'Nous faisons tout pour que les photos soient les plus représentatives possible. L\'impression HD garantit une reproduction fidèle des designs. De légères variations peuvent exister selon les écrans.' },
  { q:'Livrez-vous hors de Bamako ?', r:'Pour l\'instant, nous livrons uniquement dans Bamako et ses environs immédiats. Pour des livraisons dans d\'autres villes, contactez-nous sur WhatsApp pour étudier les possibilités.' },
  { q:'Puis-je commander plusieurs coques ?', r:'Oui, et nous recommandons de grouper les commandes — les frais de livraison sont partagés. Précisez simplement tous vos choix dans le message WhatsApp.' },
  { q:'Que faire si ma coque est défectueuse ?', r:'Contactez-nous dans les 48h suivant la réception avec une photo du problème. Nous procéderons à un échange sans frais supplémentaires.' },
  { q:'Puis-je personnaliser un design ?', r:'Nous ne faisons pas encore de personnalisation individuelle, mais si vous souhaitez un design particulier, écrivez-nous sur WhatsApp — nous étudions chaque demande.' },
];
---
<Base title="FAQ — Questions Fréquentes · CultureCase" description="Réponses aux questions fréquentes sur les commandes, livraisons et produits CultureCase." currentPage="">

<div style="background:#120500;padding:2rem 2.5rem;border-bottom:2px solid rgba(232,160,32,.2)">
  <div style="max-width:760px;margin:0 auto">
    <h1 style="font-family:'Bebas Neue',sans-serif;font-size:38px;letter-spacing:3px;color:#fff;line-height:.9">Questions <em style="color:#E8A020;font-style:normal">fréquentes</em></h1>
  </div>
</div>

<div style="max-width:760px;margin:0 auto;padding:2.5rem;display:flex;flex-direction:column;gap:1rem">

  {questions.map(item => (
    <details style="background:#fff;border:1.5px solid #E2CEAA;border-radius:10px;overflow:hidden">
      <summary style="padding:1.1rem 1.5rem;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:1px;color:#0F0700;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center">
        {item.q}
        <span style="color:#D94E15;font-size:18px;flex-shrink:0;margin-left:1rem">+</span>
      </summary>
      <div style="padding:.75rem 1.5rem 1.25rem;border-top:1px solid #E2CEAA">
        <p style="font-size:13px;color:#5A3E28;line-height:1.85">{item.r}</p>
      </div>
    </details>
  ))}

  <div style="text-align:center;padding-top:1rem">
    <p style="font-size:13px;color:#9A7848;margin-bottom:1rem">Vous ne trouvez pas votre réponse ?</p>
    <a href="https://wa.me/22375992482" target="_blank" rel="noopener"
      style="background:#D94E15;color:#fff;font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:2px;padding:12px 28px;border-radius:6px;text-decoration:none;display:inline-block">
      Posez-nous la question →
    </a>
  </div>

</div>
</Base>
