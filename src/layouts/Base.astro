---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPage?: string;
}

const {
  title = "CultureCase — Coques iPhone made in Mali",
  description = "Coques iPhone inspirées de la culture malienne. Bogolan, N'Ko, Djenné, Ciwara. Livraison à Bamako.",
  image = "https://res.cloudinary.com/dknfqd2xp/image/upload/w_600,f_auto,q_auto/v1779767675/zutdygs9wnxbheeilcl9.jpg",
  currentPage = "home",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:;" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_ML" />
  <meta name="twitter:card" content="summary_large_image" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎨</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" />
  <style>
    html{overflow-x:hidden;max-width:100%;scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    img,video,svg,iframe{max-width:100%}
    :root{
      --ink:#0F0700;--ember:#D94E15;--ember2:#C03A08;--gold:#E8A020;--gold2:#C98010;
      --sand:#F4EAD0;--warm:#FBF6ED;--clay:#B5601A;--dusk:#1A0800;--dusk2:#120500;
      --cream:#FDFAF3;--border:#E2CEAA;--border2:#D4BC96;--muted:#9A7848;--leaf:#1E5C35;
      --shadow-card:0 2px 8px rgba(15,7,0,.06),0 1px 2px rgba(15,7,0,.04);
      --shadow-hover:0 16px 48px rgba(217,78,21,.16),0 4px 16px rgba(15,7,0,.10);
      --shadow-deep:0 32px 80px rgba(15,7,0,.35);
      --radius-sm:3px;--radius:6px;--radius-lg:10px;
      --transition:cubic-bezier(0.22,1,0.36,1);
    }
    body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--ink);overflow-x:hidden;font-size:14px;line-height:1.6}
    /* NAV */
    .nav{background:var(--dusk2);height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 2.5rem;border-bottom:2px solid rgba(232,160,32,.3);position:sticky;top:0;z-index:300;backdrop-filter:blur(12px)}
    .nav::before{content:'';position:absolute;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;opacity:.5}
    .logo{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:6px;color:var(--gold);text-decoration:none;line-height:1;position:relative;z-index:1;transition:letter-spacing .4s var(--transition),color .2s;display:block}
    .logo:hover{letter-spacing:9px;color:#F0B030}
    .logo-sub{font-family:'DM Sans',sans-serif;font-size:8px;letter-spacing:3.5px;color:rgba(232,160,32,.45);text-transform:uppercase;display:block;margin-top:1px;font-weight:500}
    .nav-r{display:flex;align-items:center;gap:2px;position:relative;z-index:1}
    .nb{background:none;border:none;color:rgba(255,255,255,.55);font-size:11.5px;font-weight:500;letter-spacing:.8px;text-transform:uppercase;padding:8px 16px;cursor:pointer;transition:color .2s;font-family:'DM Sans',sans-serif;position:relative;text-decoration:none;display:inline-block}
    .nb::after{content:'';position:absolute;bottom:3px;left:50%;right:50%;height:1.5px;background:var(--gold);border-radius:2px;transition:left .28s var(--transition),right .28s var(--transition)}
    .nb:hover,.nb.on{color:rgba(255,255,255,.92)}
    .nb:hover::after,.nb.on::after{left:14px;right:14px}
    /* FOOTER */
    .footer{background:var(--dusk2);border-top:2px solid rgba(232,160,32,.2);padding:0}
    .footer-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:2rem;padding:2.5rem;border-bottom:1px solid rgba(255,255,255,.05)}
    .footer-logo{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:5px;color:var(--gold);margin-bottom:.6rem}
    .footer-tagline{font-size:11.5px;color:rgba(255,255,255,.35);line-height:1.75;margin-bottom:1rem}
    .footer-social{display:flex;gap:8px}
    .footer-soc-btn{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:transform .2s,background .2s;color:#fff;text-decoration:none}
    .footer-soc-wa{background:rgba(37,211,102,.15)}.footer-soc-wa:hover{background:#25D366;transform:scale(1.1)}
    .footer-soc-ig{background:rgba(193,53,132,.15)}.footer-soc-ig:hover{background:#C13584;transform:scale(1.1)}
    .footer-soc-tt{background:rgba(255,255,255,.08)}.footer-soc-tt:hover{background:rgba(255,255,255,.18);transform:scale(1.1)}
    .footer-col-title{font-size:9px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:rgba(232,160,32,.6);margin-bottom:.85rem}
    .footer-links{list-style:none}.footer-links li{margin-bottom:.4rem}
    .footer-links a{color:rgba(255,255,255,.38);font-size:12px;text-decoration:none;transition:color .2s;display:inline-block;padding:2px 0}
    .footer-links a:hover{color:rgba(255,255,255,.75)}
    .footer-bottom{display:flex;align-items:center;justify-content:space-between;padding:1rem 2.5rem;font-size:10.5px;color:rgba(255,255,255,.2);letter-spacing:.5px}
    /* BOUTONS */
    .btn-primary{background:var(--ember);color:#fff;border:none;font-family:'Bebas Neue',sans-serif;font-size:14px;letter-spacing:2.5px;padding:12px 28px;border-radius:var(--radius);cursor:pointer;transition:background .2s,transform .2s,box-shadow .2s;display:inline-flex;align-items:center;gap:8px;text-decoration:none}
    .btn-primary:hover{background:var(--ember2);transform:translateY(-2px);box-shadow:0 8px 24px rgba(217,78,21,.3)}
    .btn-ghost{background:transparent;color:rgba(255,255,255,.65);border:1.5px solid rgba(255,255,255,.2);font-family:'DM Sans',sans-serif;font-size:12px;padding:11px 22px;border-radius:var(--radius);cursor:pointer;transition:all .2s;text-decoration:none;display:inline-block}
    .btn-ghost:hover{border-color:rgba(255,255,255,.5);color:#fff}
    /* PRODUCT CARD */
    .pc{background:#fff;border-radius:var(--radius-lg);overflow:hidden;border:1.5px solid var(--border);box-shadow:var(--shadow-card);cursor:pointer;transition:transform .3s var(--transition),box-shadow .3s var(--transition);display:block;text-decoration:none;color:inherit}
    .pc:hover{transform:translateY(-5px);box-shadow:var(--shadow-hover)}
    .pc-img-wrap{aspect-ratio:3/4;overflow:hidden;background:var(--sand);position:relative}
    .pc-img-wrap img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s var(--transition),filter .3s}
    .pc:hover .pc-img-wrap img{transform:scale(1.04);filter:brightness(1.04)}
    .pc-body{padding:.85rem 1rem 1rem}
    .pc-name{font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:1.5px;color:var(--ink);margin-bottom:.3rem;line-height:1.1}
    .pc-cat{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--ember);margin-bottom:.5rem}
    .pc-price{font-size:12px;font-weight:600;color:var(--muted)}
    .pc-stock-dot{display:inline-block;width:6px;height:6px;border-radius:50%;margin-right:4px;vertical-align:middle}
    .dot-ok{background:#22c55e}.dot-low{background:var(--gold)}.dot-out{background:#ef4444}
    /* PRODUCT GRID */
    .prod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;padding:1.5rem 2rem}
    @media(max-width:768px){.prod-grid{grid-template-columns:repeat(2,1fr);gap:10px;padding:1rem}}
    /* PAGE DÉTAIL */
    .det-grid{display:grid;grid-template-columns:1fr 1fr;gap:3.5rem;align-items:start}
    .det-imgbox{border-radius:var(--radius-lg);overflow:hidden;aspect-ratio:1;background:var(--sand);border:2px solid var(--border);box-shadow:var(--shadow-deep);position:relative}
    .det-imgbox img{width:100%;height:100%;object-fit:cover;display:block}
    .det-title{font-family:'Bebas Neue',sans-serif;font-size:46px;letter-spacing:2px;color:var(--ink);line-height:.9;margin-bottom:.65rem}
    .det-story{font-family:'Cormorant Garamond',serif;font-size:15px;color:var(--muted);line-height:1.75;margin-bottom:1.4rem;border-left:3px solid var(--gold);padding-left:14px;font-style:italic}
    .prix-box{background:var(--sand);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1rem 1.25rem;margin-bottom:1.25rem}
    .prix-lbl{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:.75rem}
    .prix-row{display:flex;gap:1.5rem}
    .prix-tier{display:flex;flex-direction:column;gap:3px}
    .prix-tier-lbl{font-size:10px;color:var(--muted)}
    .prix-val{font-size:1.3rem;font-weight:700;color:var(--ember);font-family:'Bebas Neue',sans-serif;letter-spacing:1px}
    .det-sel{width:100%;border:1.5px solid var(--border2);background:var(--warm);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:13px;padding:10px 12px;border-radius:var(--radius);cursor:pointer;transition:border-color .2s;margin-bottom:1rem;-webkit-appearance:none}
    .det-sel:focus{outline:none;border-color:var(--ember)}
    .wa-btn{display:block;background:var(--ember);color:#fff;text-align:center;padding:14px;border-radius:var(--radius);font-weight:700;font-size:15px;text-decoration:none;letter-spacing:1px;font-family:'Bebas Neue',sans-serif;transition:background .2s,transform .2s;border:none;cursor:pointer;width:100%}
    .wa-btn:hover{background:var(--ember2);transform:translateY(-1px)}
    .wa-btn:disabled{opacity:.4;pointer-events:none}
    .stock-ok{color:var(--leaf)}.stock-low{color:var(--gold2)}.stock-out{color:var(--ember2)}
    /* BREADCRUMB */
    .breadcrumb{font-size:12px;color:var(--muted);margin-bottom:2rem;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
    .breadcrumb a{color:var(--ember);text-decoration:none}.breadcrumb a:hover{text-decoration:underline}
    /* RESPONSIVE */
    @media(max-width:768px){
      .nav{padding:0 1rem;height:60px}
      .nav-links{display:none}
      .det-grid{grid-template-columns:1fr;gap:1.5rem}
      .footer-top{grid-template-columns:1fr 1fr;gap:1.5rem;padding:1.5rem}
      .footer-bottom{flex-direction:column;gap:.5rem;text-align:center}
      .prod-grid{grid-template-columns:repeat(2,1fr)}
    }
  </style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <a href={`${base}/`} class="logo">CULTURECASE<span class="logo-sub">Bamako · Mali</span></a>
  <div class="nav-r">
    <div class="nav-links">
      <a href={`${base}/`}        class={`nb ${currentPage==='home'?'on':''}`}>Accueil</a>
      <a href={`${base}/catalogue`} class={`nb ${currentPage==='catalogue'?'on':''}`}>Catalogue</a>
      <a href={`${base}/histoire`}  class={`nb ${currentPage==='histoire'?'on':''}`}>Histoire</a>
      <a href={`${base}/blog`}      class={`nb ${currentPage==='blog'?'on':''}`}>Blog</a>
      <a href={`${base}/contact`}   class={`nb ${currentPage==='contact'?'on':''}`}>Contact</a>
    </div>
  </div>
</nav>

<!-- CONTENU -->
<slot />

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-top">
    <div>
      <div class="footer-logo">CULTURECASE</div>
      <p class="footer-tagline">L'âme du Mali, dans ta main.<br>Designs exclusifs inspirés du patrimoine malien.</p>
      <div class="footer-social">
        <a href="https://wa.me/22375992482" target="_blank" rel="noopener" class="footer-soc-btn footer-soc-wa" aria-label="WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
        <a href="https://www.instagram.com/culturecase_official" target="_blank" rel="noopener" class="footer-soc-btn footer-soc-ig" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <p class="footer-col-title">Navigation</p>
      <ul class="footer-links">
        <li><a href={`${base}/`}>Accueil</a></li>
        <li><a href={`${base}/catalogue`}>Catalogue</a></li>
        <li><a href={`${base}/histoire`}>Notre histoire</a></li>
        <li><a href={`${base}/blog`}>Blog</a></li>
        <li><a href={`${base}/contact`}>Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-col-title">Informations</p>
      <ul class="footer-links">
        <li><a href={`${base}/livraison`}>Livraison & retours</a></li>
        <li><a href={`${base}/paiement`}>Modes de paiement</a></li>
        <li><a href={`${base}/faq`}>FAQ</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-col-title">Commander</p>
      <ul class="footer-links">
        <li><a href="https://wa.me/22375992482" target="_blank" rel="noopener">WhatsApp direct</a></li>
        <li><a href={`${base}/catalogue`}>Voir les designs</a></li>
      </ul>
      <div style="margin-top:1rem;font-size:11px;color:rgba(255,255,255,.25);line-height:1.8">
        📍 Bamako, Mali<br>
        📦 Livraison Bamako<br>
        💬 Réponse rapide WA
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} CultureCase · Tous droits réservés</span>
    <span>Fait avec ❤️ à Bamako</span>
  </div>
</footer>

</body>
</html>
